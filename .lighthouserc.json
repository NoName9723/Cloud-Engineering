{
  "ci": {
    "collect": {
      "numberOfRuns": 1,
      "startServerCommand": "npx --yes http-server@14 . -p 4173 -c-1",
      "startServerReadyPattern": "Available on",
      "startServerReadyTimeout": 30000,
      "url": [
        "http://127.0.0.1:4173/index.html",
        "http://127.0.0.1:4173/expertise.html",
        "http://127.0.0.1:4173/solutions.html",
        "http://127.0.0.1:4173/architecture.html",
        "http://127.0.0.1:4173/technologies.html",
        "http://127.0.0.1:4173/company.html",
        "http://127.0.0.1:4173/contact.html",
        "http://127.0.0.1:4173/account.html",
        "http://127.0.0.1:4173/lab.html"
      ],
      "settings": {
        "chromeFlags": "--no-sandbox"
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
