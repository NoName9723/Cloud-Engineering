{
  "name": "nexora-cloud-engineering",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {"node": ">=26 <27"},
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --watch --env-file-if-exists=.env server/index.js",
    "preview": "node --env-file-if-exists=.env server/preview.js",
    "db:migrate": "node --env-file-if-exists=.env server/db/migrate.js",
    "test": "npm run test:site && npm run test:unit && npm run test:e2e",
    "test:site": "node tests/site-check.mjs && node tests/cloud-lab.test.mjs",
    "test:unit": "node --test tests/backend.test.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "connect-pg-simple": "10.0.0",
    "express": "5.3.0",
    "express-rate-limit": "8.7.4",
    "express-session": "1.19.0",
    "helmet": "8.3.0",
    "pg": "8.23.1"
  },
  "devDependencies": {"@playwright/test": "1.65.0"}
}
